# Database (MySQL 8). Matches the `db` service in docker-compose.yml
DATABASE_URL=mysql://test_user:test_password@127.0.0.1:3306/test_management_tool

# Signs login sessions. At least 32 characters. Fine for local development; production refuses this
# placeholder, so generate a real one there: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Number of reverse proxies in front of the app (e.g. 1 behind a load balancer or ingress). 0 when accessed directly
TRUST_PROXY=0

# Optional: name and logo shown inside the app
VITE_APP_TITLE=QualityLoom
VITE_APP_LOGO=
